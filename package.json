{
  "name": "numnum",
  "version": "0.1.0",
  "private": true,
  "description": "numnum — video-first food discovery and WhatsApp ordering web app for Lebanon",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && npm run db:setup && RAYON_NUM_THREADS=2 UV_THREADPOOL_SIZE=2 TOKIO_WORKER_THREADS=2 NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "TOKIO_WORKER_THREADS=2 UV_THREADPOOL_SIZE=4 next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "npm run db:setup",
    "billing:run": "tsx --tsconfig tsconfig.json --require ./scripts/cli-shim.cjs scripts/run-billing.ts",
    "postinstall": "prisma generate",
    "worker": "tsx --tsconfig tsconfig.json --require ./scripts/cli-shim.cjs scripts/worker.ts",
    "test:e2e": "node e2e/customer-strict.js && node e2e/admin-verify.js && node e2e/broadcast.js && node e2e/restaurant-signup.js && node e2e/order-dispute.js && node e2e/store-requirements.js && node e2e/native-push.js && node e2e/store-links.js && node e2e/launch-check.js && node e2e/features.js && node e2e/business.js",
    "build:local": "prisma generate && next build",
    "db:setup": "tsx --tsconfig tsconfig.json --require ./scripts/cli-shim.cjs prisma/seed.ts",
    "demo:media": "tsx --tsconfig tsconfig.json --require ./scripts/cli-shim.cjs scripts/demo-media.ts"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/cairo": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.4",
    "jszip": "^3.10.1",
    "leaflet": "1.9",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "tus-js-client": "^4.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    },
    "deepmerge-ts": "^8.0.2"
  }
}

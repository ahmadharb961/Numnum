# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used for uploads, the WhatsApp contact redirect, reports and expiry.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used for auth redirects, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the "Continue with Google" button (enable Google in Supabase → Authentication → Providers first)
NEXT_PUBLIC_GOOGLE_AUTH=true

# Secret for GET /api/cron/expire (Authorization: Bearer <CRON_SECRET>). Optional when pg_cron is enabled.
CRON_SECRET=change-me
# Salt for hashing visitor IPs on reports (any long random string)
IP_HASH_SALT=change-me-too

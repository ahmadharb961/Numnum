<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (App Store / TestFlight builds use Apple's production service) -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal links: numnum.me links (shared reels, dishes, restaurants, orders) open in the app -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:numnum.me</string>
		<string>applinks:www.numnum.me</string>
	</array>
</dict>
</plist>

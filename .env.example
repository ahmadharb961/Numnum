# Copy this file to `.env` and fill in the values. Never commit `.env`.
# On Hostinger, enter the same names and values as the app's environment variables.
# Step-by-step guide: docs/SETUP.md

# --- Database (Neon PostgreSQL, connection pooling OFF) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Your site address (no trailing slash) ---
APP_URL="https://yourdomain.com"

# --- Security: long random strings (openssl rand -base64 32) ---
SESSION_SECRET=""
# The Hostinger cron job sends this to /api/cron
CRON_SECRET=""

# --- First admin (created on deploy if it doesn't exist yet) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Video (Cloudflare Stream): same account/token as Hireel works ---
CLOUDFLARE_ACCOUNT_ID=""
# My Profile → API Tokens → Create Token → permission "Stream: Edit"
CLOUDFLARE_STREAM_API_TOKEN=""
# Optional: learned automatically from Cloudflare
# CLOUDFLARE_STREAM_CUSTOMER_CODE=""

# --- Email (Hostinger mailbox) ---
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@yourdomain.com"
SMTP_PASS=""
MAIL_FROM="numnum <no-reply@yourdomain.com>"

# --- Optional ---
# "true" adds 6 demo restaurants on deploy (demo/sales only)
# SEED_DEMO="true"
# Google Maps key (HTTP-referrer restricted) for the map preview at checkout
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Local development only ---
# Without Cloudflare Stream, videos are transcoded locally with ffmpeg into STORAGE_DIR
# STORAGE_DIR="./storage"
# INLINE_JOBS="true"
# TEST_DATABASE_URL="postgresql://numnum:numnum@localhost:5432/numnum_test"

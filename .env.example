# PostgreSQL connection string
DATABASE_URL="postgresql://numnum:numnum@localhost:5432/numnum"
# Public base URL (used in share links, WhatsApp messages, sitemap)
APP_URL="https://numnum.example"
# Long random string used to hash session tokens and device ids
SESSION_SECRET="replace-with-64-random-characters"

# Media storage: "local" (default, writes to ./storage) or "cloudinary"
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# Required when STORAGE_DRIVER=cloudinary (public images & videos only; receipts stay local/private)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Google Maps JavaScript API key for location picking (restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional SMTP for email notifications (dashboard notifications always work)
SMTP_URL=""
EMAIL_FROM="numnum <no-reply@numnum.example>"

# First admin account created by `npm run db:seed` in production mode
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Set to "true" to load demo restaurants/reels in development seeding
SEED_DEMO="true"

# Bearer token required by GET /api/cron (call hourly from your scheduler)
CRON_SECRET="replace-with-random-string"
# Set to "false" on web instances when a dedicated `npm run worker` process runs
INLINE_JOBS="true"
# Postgres database for `npm test` (name must end in _test)
TEST_DATABASE_URL="postgresql://numnum:numnum@localhost:5432/numnum_test"
